# ── Supabase ──────────────────────────────────────────────
# 값은 Supabase 대시보드에서 복사:
#   https://supabase.com/dashboard → 프로젝트 선택 → Settings → API

# 프로젝트 URL (예: https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# anon public 키 — 브라우저 노출 OK (RLS 로 보호되는 공개 키)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role 키 — RLS 우회 키. 절대 클라이언트에 노출 금지! 서버에서만 사용.
SUPABASE_SERVICE_ROLE_KEY=

# ── 베타 가입 ─────────────────────────────────────────────
# 임시 이메일 가입을 막는 초대코드. 이 값을 아는 사람만 가입 가능.
# 아무 문자열이나 정해서 .env.local 에 넣고, 베타 사장님에게만 공유하세요.
# (값이 비어 있으면 가입이 전면 차단됩니다.)
BETA_SIGNUP_CODE=
